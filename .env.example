# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase.
# Si dejás estas variables vacías, la app arranca en modo demo (datos de prueba en el navegador).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Clave pública VAPID para notificaciones push (npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
